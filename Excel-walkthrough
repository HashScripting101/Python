#!/usr/bin/env python3
"""
xlsx_web_runner.py

Walk an Excel sheet row by row. When a row's trigger cell matches one of the
configured keywords, hit a URL for that row (prompting once per host for
credentials), then write SUCCESS / FAILURE back into a status column.

Usage:
    python xlsx_web_runner.py --input targets.xlsx
    python xlsx_web_runner.py --input targets.xlsx --dry-run     # no network, just test the walk
    python xlsx_web_runner.py --input targets.xlsx --in-place    # overwrite instead of *_results.xlsx
    python xlsx_web_runner.py --input targets.xlsx --insecure    # skip TLS verify (internal/self-signed)

Assumptions (all editable in the CONFIG block):
  - Row 1 is a header row.
  - There is a column whose header == TRIGGER_HEADER; its value decides whether
    the row fires.
  - There is a column whose header == URL_HEADER holding the target URL for that
    row. (If your URL is fixed, set URL_HEADER = None and set FIXED_URL.)
  - Results are written into STATUS_HEADER (created if absent).
"""

import argparse
import datetime as _dt
import getpass
import sys
from urllib.parse import urlparse

import openpyxl
import requests
from requests.auth import HTTPBasicAuth

# ----------------------------- CONFIG ----------------------------------------
SHEET_NAME    = None            # None = active sheet, or "Sheet1"
TRIGGER_HEADER = "Trigger"      # column to inspect on each row
TRIGGER_VALUES = ["run", "go", "check"]   # fires if the trigger cell contains any of these (case-insensitive)
TRIGGER_MODE   = "contains"     # "contains" | "equals" | "nonempty"
URL_HEADER     = "URL"          # column holding the per-row URL; set to None to use FIXED_URL
FIXED_URL      = None           # e.g. "https://internal.example.com/health" when URL_HEADER is None
STATUS_HEADER  = "Status"       # where results get written
METHOD         = "GET"          # HTTP method
TIMEOUT        = 15             # seconds
USE_BASIC_AUTH = True           # send HTTP Basic auth; see login_form() note below for form logins
SUCCESS_MAX    = 399            # status codes <= this count as success
# -----------------------------------------------------------------------------


def norm(v):
    return "" if v is None else str(v).strip()


def row_fires(trigger_cell_value: str) -> bool:
    val = norm(trigger_cell_value)
    if TRIGGER_MODE == "nonempty":
        return val != ""
    if not val:
        return False
    lo = val.lower()
    if TRIGGER_MODE == "equals":
        return any(lo == t.lower() for t in TRIGGER_VALUES)
    return any(t.lower() in lo for t in TRIGGER_VALUES)  # contains


def header_map(ws):
    """Map header text -> 1-based column index using row 1."""
    out = {}
    for col in range(1, ws.max_column + 1):
        h = norm(ws.cell(row=1, column=col).value)
        if h:
            out[h] = col
    return out


class CredCache:
    """Prompt once per host, reuse for the rest of the run."""
    def __init__(self, per_host=True):
        self.per_host = per_host
        self._cache = {}

    def get(self, url):
        key = urlparse(url).netloc if self.per_host else "__global__"
        if key not in self._cache:
            label = key or url
            sys.stderr.write(f"\n--- Credentials for {label} ---\n")
            user = input("  Username: ").strip()
            pw = getpass.getpass("  Password: ")
            self._cache[key] = (user, pw)
        return self._cache[key]


def do_request(url, creds, insecure, dry_run):
    """Return (ok: bool, detail: str)."""
    if dry_run:
        return True, "DRY-RUN (no request sent)"
    auth = HTTPBasicAuth(*creds) if (USE_BASIC_AUTH and creds) else None
    try:
        resp = requests.request(
            METHOD, url, auth=auth, timeout=TIMEOUT, verify=not insecure,
            allow_redirects=True,
        )
        ok = resp.status_code <= SUCCESS_MAX
        return ok, f"HTTP {resp.status_code}"
    except requests.exceptions.SSLError as e:
        return False, f"SSL error ({e.__class__.__name__})"
    except requests.exceptions.ConnectTimeout:
        return False, "connect timeout"
    except requests.exceptions.ReadTimeout:
        return False, "read timeout"
    except requests.exceptions.ConnectionError:
        return False, "connection error"
    except requests.exceptions.RequestException as e:
        return False, f"{e.__class__.__name__}: {e}"


# --- If your SaaS needs a real login form instead of Basic auth, replace the
# --- auth line above with a requests.Session() that POSTs to the login endpoint
# --- once, then reuse that session for each row. Sketch:
#
#   session = requests.Session()
#   session.post("https://app/login", data={"user": u, "pass": p})
#   resp = session.get(url)          # session carries the cookie
#
# --- MFA can't be scripted blindly: log in once by hand, capture the cookie,
# --- and load it into the session.


def main():
    ap = argparse.ArgumentParser(description="Walk an Excel sheet and hit URLs on matching rows.")
    ap.add_argument("--input", required=True, help="path to the .xlsx file")
    ap.add_argument("--sheet", default=SHEET_NAME, help="sheet name (default: active)")
    ap.add_argument("--in-place", action="store_true", help="overwrite the input file")
    ap.add_argument("--dry-run", action="store_true", help="walk + write status but send no requests")
    ap.add_argument("--insecure", action="store_true", help="skip TLS verification")
    ap.add_argument("--global-creds", action="store_true",
                    help="prompt for one credential set for all hosts (default: per host)")
    args = ap.parse_args()

    wb = openpyxl.load_workbook(args.input)
    ws = wb[args.sheet] if args.sheet else wb.active

    hdr = header_map(ws)
    if TRIGGER_HEADER not in hdr:
        sys.exit(f"ERROR: trigger column '{TRIGGER_HEADER}' not found. Headers: {list(hdr)}")
    if URL_HEADER and URL_HEADER not in hdr and not FIXED_URL:
        sys.exit(f"ERROR: URL column '{URL_HEADER}' not found and no FIXED_URL set. Headers: {list(hdr)}")

    # Ensure a status column exists.
    if STATUS_HEADER not in hdr:
        new_col = ws.max_column + 1
        ws.cell(row=1, column=new_col, value=STATUS_HEADER)
        hdr[STATUS_HEADER] = new_col

    tcol, scol = hdr[TRIGGER_HEADER], hdr[STATUS_HEADER]
    ucol = hdr.get(URL_HEADER) if URL_HEADER else None

    creds = CredCache(per_host=not args.global_creds)
    fired = ok_n = fail_n = 0

    for r in range(2, ws.max_row + 1):
        trig = ws.cell(row=r, column=tcol).value
        if not row_fires(trig):
            continue
        fired += 1

        url = norm(ws.cell(row=r, column=ucol).value) if ucol else FIXED_URL
        if not url:
            ws.cell(row=r, column=scol, value=f"FAILURE (no URL) @ {_dt.datetime.now():%Y-%m-%d %H:%M:%S}")
            fail_n += 1
            print(f"  row {r}: no URL -> FAILURE")
            continue

        c = creds.get(url) if USE_BASIC_AUTH else None
        ok, detail = do_request(url, c, args.insecure, args.dry_run)
        stamp = _dt.datetime.now().strftime("%Y-%m-%d %H:%M:%S")
        ws.cell(row=r, column=scol,
                value=f"{'SUCCESS' if ok else 'FAILURE'} ({detail}) @ {stamp}")
        ok_n += ok
        fail_n += (not ok)
        print(f"  row {r}: {url} -> {'SUCCESS' if ok else 'FAILURE'} ({detail})")

    out = args.input if args.in_place else args.input.rsplit(".", 1)[0] + "_results.xlsx"
    wb.save(out)
    print(f"\nDone. {fired} row(s) fired | {ok_n} success | {fail_n} failure")
    print(f"Saved: {out}")


if __name__ == "__main__":
    main()
